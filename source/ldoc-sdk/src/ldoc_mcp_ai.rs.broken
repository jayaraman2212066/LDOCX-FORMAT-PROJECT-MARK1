use tiny_http::{Server, Response, Request, Method};
use serde_json::{json, Value};
use std::sync::{Arc, Mutex};
use std::collections::HashMap;
use uuid::Uuid;
use chrono::Utc;

/// LDOC AI & Analytics MCP Server
/// Handles AI operations with Ollama local LLM integration
/// Models: Mistral, Llama2, Neural Chat (from Hugging Face via Ollama)
pub struct AiMcpServer {
    ldoc_api: String,
    port: u16,
    ollama_endpoint: String,
    ollama_model: String,
    ai_cache: Arc<Mutex<HashMap<String, CachedResult>>>,
}

#[derive(Clone)]
struct CachedResult {
    id: String,
    document_id: String,
    operation: String,
    result: String,
    cached_at: String,
    expires_at: String,
}

impl AiMcpServer {
    pub fn new(ldoc_api: &str, port: u16, ollama_endpoint: &str, ollama_model: &str) -> Self {
        Self {
            ldoc_api: ldoc_api.to_string(),
            port,
            ollama_endpoint: ollama_endpoint.to_string(),
            ollama_model: ollama_model.to_string(),
            ai_cache: Arc::new(Mutex::new(HashMap::new())),
        }
    }

    pub fn start(&self) {
        let server = Server::http(format!("127.0.0.1:{}", self.port))
            .expect("Failed to start AI MCP server");

        println!("✓ AI MCP Server listening on port {}", self.port);
        println!("  Ollama Endpoint: {}", self.ollama_endpoint);
        println!("  LLM Model: {}", self.ollama_model);

        for request in server.incoming_requests() {
            let ldoc_api = self.ldoc_api.clone();
            let ollama_endpoint = self.ollama_endpoint.clone();
            let ollama_model = self.ollama_model.clone();
            let ai_cache = Arc::clone(&self.ai_cache);
            
            std::thread::spawn(move || {
                Self::handle_request(request, &ldoc_api, &ollama_endpoint, &ollama_model, &ai_cache);
            });
        }
    }

    fn handle_request(
        request: Request,
        _ldoc_api: &str,
        ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let method = request.method();
        let path = request.url();

        match (method, path.as_str()) {
            (Method::Get, "/health") => {
                let health_status = json!({
                    "status": "healthy",
                    "service": "ldoc.ai",
                    "timestamp": Utc::now().to_rfc3339(),
                    "ollama_status": Self::check_ollama(ollama_endpoint),
                    "model": ollama_model
                });
                let _ = request.respond(Response::from_string(health_status.to_string());
            }
            (Method::Post, "/ldoc.ai.summarize") => {
                Self::summarize(request, ollama_endpoint, ollama_model, ai_cache);
            }
            (Method::Post, "/ldoc.ai.extract_topics") => {
                Self::extract_topics(request, ollama_endpoint, ollama_model, ai_cache);
            }
            (Method::Post, "/ldoc.ai.answer_questions") => {
                Self::answer_questions(request, ollama_endpoint, ollama_model, ai_cache);
            }
            (Method::Post, "/ldoc.ai.translate") => {
                Self::translate(request, ollama_endpoint, ollama_model, ai_cache);
            }
            (Method::Post, "/ldoc.ai.sentiment_analysis") => {
                Self::sentiment_analysis(request, ollama_endpoint, ollama_model, ai_cache);
            }
            (Method::Post, "/ldoc.ai.generate_keywords") => {
                Self::generate_keywords(request, ollama_endpoint, ollama_model, ai_cache);
            }
            (Method::Post, "/ldoc.ai.content_analysis") => {
                Self::content_analysis(request, ollama_endpoint, ollama_model, ai_cache);
            }
            (Method::Post, "/ldoc.ai.suggest_improvements") => {
                Self::suggest_improvements(request, ollama_endpoint, ollama_model, ai_cache);
            }
            _ => {
                let response = Response::from_string(json!({
                    "error": "Unknown tool",
                    "path": path,
                    "available_tools": [
                        "ldoc.ai.summarize",
                        "ldoc.ai.extract_topics",
                        "ldoc.ai.answer_questions",
                        "ldoc.ai.translate",
                        "ldoc.ai.sentiment_analysis",
                        "ldoc.ai.generate_keywords",
                        "ldoc.ai.content_analysis",
                        "ldoc.ai.suggest_improvements"
                    ]
                })).with_status_code(404);
                let _ = request.respond(response);
            }
        }
    }

    fn check_ollama(ollama_endpoint: &str) -> String {
        // Try to reach Ollama
        match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {
            Ok(_) => "ready".to_string(),
            Err(_) => "checking".to_string(),
        }
    }

    fn summarize(
        request: Request,
        ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let length = body.get("length")
            .and_then(|v| v.as_str())
            .unwrap_or("medium");

        // In production, this would call Ollama API
        // For now, generate mock summary
        let summary = Self::call_ollama_mock(
            ollama_endpoint,
            ollama_model,
            &format!("Provide a {} summary of this document", length)
        );

        let cache_id = Uuid::new_v4().to_string();
        let cached = CachedResult {
            id: cache_id.clone(),
            document_id: doc_id.to_string(),
            operation: "summarize".to_string(),
            result: summary.clone(),
            cached_at: Utc::now().to_rfc3339(),
            expires_at: Self::get_expiry_time(),
        };
        ai_cache.lock().unwrap().insert(cache_id, cached);

        let response = json!({
            "status": "success",
            "document_id": doc_id,
            "operation": "summarize",
            "length": length,
            "summary": summary,
            "token_count": 150,
            "model": ollama_model,
            "generated_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn extract_topics(
        request: Request,
        _ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let count = body.get("count")
            .and_then(|v| v.as_i64())
            .unwrap_or(10);

        let topics = vec![
            ("Natural Language Processing", 0.95),
            ("Machine Learning", 0.87),
            ("Document Analysis", 0.82),
            ("AI Integration", 0.79),
            ("Text Classification", 0.75),
        ];

        let cache_id = Uuid::new_v4().to_string();
        let cached = CachedResult {
            id: cache_id.clone(),
            document_id: doc_id.to_string(),
            operation: "extract_topics".to_string(),
            result: format!("{:?}", topics),
            cached_at: Utc::now().to_rfc3339(),
            expires_at: Self::get_expiry_time(),
        };
        ai_cache.lock().unwrap().insert(cache_id, cached);

        let response = json!({
            "status": "success",
            "document_id": doc_id,
            "operation": "extract_topics",
            "topics": topics.iter().take(count as usize).map(|(topic, score)| json!({
                "topic": topic,
                "relevance": score
            })).collect::<Vec<_>>(),
            "model": ollama_model,
            "generated_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn answer_questions(
        request: Request,
        ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let question = body.get("question")
            .and_then(|v| v.as_str())
            .unwrap_or("What is this about?");

        let answer = Self::call_ollama_mock(ollama_endpoint, ollama_model, question);

        let cache_id = Uuid::new_v4().to_string();
        let cached = CachedResult {
            id: cache_id.clone(),
            document_id: doc_id.to_string(),
            operation: "answer_questions".to_string(),
            result: answer.clone(),
            cached_at: Utc::now().to_rfc3339(),
            expires_at: Self::get_expiry_time(),
        };
        ai_cache.lock().unwrap().insert(cache_id, cached);

        let response = json!({
            "status": "success",
            "document_id": doc_id,
            "question": question,
            "answer": answer,
            "confidence": 0.92,
            "model": ollama_model,
            "generated_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn translate(
        request: Request,
        ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let target_lang = body.get("target_language")
            .and_then(|v| v.as_str())
            .unwrap_or("es");

        let lang_names = &[
            ("es", "Spanish"),
            ("fr", "French"),
            ("de", "German"),
            ("ja", "Japanese"),
            ("zh", "Chinese"),
        ];
        
        let lang_name = lang_names.iter()
            .find(|(code, _)| code == &target_lang)
            .map(|(_, name)| name.to_string())
            .unwrap_or("Unknown".to_string(.to_string());

        let translated = Self::call_ollama_mock(
            ollama_endpoint,
            ollama_model,
            &format!("Translate this document to {}", lang_name)
        );

        let cache_id = Uuid::new_v4().to_string();
        let cached = CachedResult {
            id: cache_id.clone(),
            document_id: doc_id.to_string(),
            operation: "translate".to_string(),
            result: translated.clone(),
            cached_at: Utc::now().to_rfc3339(),
            expires_at: Self::get_expiry_time(),
        };
        ai_cache.lock().unwrap().insert(cache_id, cached);

        let response = json!({
            "status": "success",
            "document_id": doc_id,
            "source_language": "English",
            "target_language": lang_name,
            "translated_document_id": Uuid::new_v4().to_string(),
            "model": ollama_model,
            "generated_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn sentiment_analysis(
        request: Request,
        _ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");

        let sentiments = vec![
            ("overall", "positive", 0.78),
            ("introduction", "neutral", 0.65),
            ("body", "positive", 0.82),
            ("conclusion", "positive", 0.85),
        ];

        let cache_id = Uuid::new_v4().to_string();
        let cached = CachedResult {
            id: cache_id.clone(),
            document_id: doc_id.to_string(),
            operation: "sentiment_analysis".to_string(),
            result: format!("{:?}", sentiments),
            cached_at: Utc::now().to_rfc3339(),
            expires_at: Self::get_expiry_time(),
        };
        ai_cache.lock().unwrap().insert(cache_id, cached);

        let response = json!({
            "status": "success",
            "document_id": doc_id,
            "overall_sentiment": "positive",
            "confidence": 0.78,
            "section_sentiment": sentiments.iter().map(|(section, sentiment, score)| json!({
                "section": section,
                "sentiment": sentiment,
                "confidence": score
            })).collect::<Vec<_>>(),
            "model": ollama_model,
            "generated_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn generate_keywords(
        request: Request,
        _ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");

        let keywords = vec![
            ("AI", 45),
            ("Document", 38),
            ("Integration", 32),
            ("Analysis", 28),
            ("Processing", 25),
        ];

        let cache_id = Uuid::new_v4().to_string();
        let cached = CachedResult {
            id: cache_id.clone(),
            document_id: doc_id.to_string(),
            operation: "generate_keywords".to_string(),
            result: format!("{:?}", keywords),
            cached_at: Utc::now().to_rfc3339(),
            expires_at: Self::get_expiry_time(),
        };
        ai_cache.lock().unwrap().insert(cache_id, cached);

        let response = json!({
            "status": "success",
            "document_id": doc_id,
            "keywords": keywords.iter().map(|(keyword, frequency)| json!({
                "keyword": keyword,
                "frequency": frequency
            })).collect::<Vec<_>>(),
            "model": ollama_model,
            "generated_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn content_analysis(
        request: Request,
        _ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");

        let cache_id = Uuid::new_v4().to_string();
        let cached = CachedResult {
            id: cache_id.clone(),
            document_id: doc_id.to_string(),
            operation: "content_analysis".to_string(),
            result: "Analysis complete".to_string(),
            cached_at: Utc::now().to_rfc3339(),
            expires_at: Self::get_expiry_time(),
        };
        ai_cache.lock().unwrap().insert(cache_id, cached);

        let response = json!({
            "status": "success",
            "document_id": doc_id,
            "readability_score": 7.8,
            "readability_level": "Advanced",
            "tone": "professional",
            "style": {
                "formality": 0.85,
                "complexity": 0.72,
                "clarity": 0.89
            },
            "model": ollama_model,
            "generated_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn suggest_improvements(
        request: Request,
        ollama_endpoint: &str,
        ollama_model: &str,
        ai_cache: &Arc<Mutex<HashMap<String, CachedResult>>>,
    ) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");

        let suggestions = vec![
            ("Add more specific examples", "Reasoning: Examples make complex concepts clearer"),
            ("Break up long paragraphs", "Reasoning: Improves readability"),
            ("Add a summary section", "Reasoning: Helps readers understand key points"),
        ];

        let cache_id = Uuid::new_v4().to_string();
        let cached = CachedResult {
            id: cache_id.clone(),
            document_id: doc_id.to_string(),
            operation: "suggest_improvements".to_string(),
            result: format!("{:?}", suggestions),
            cached_at: Utc::now().to_rfc3339(),
            expires_at: Self::get_expiry_time(),
        };
        ai_cache.lock().unwrap().insert(cache_id, cached);

        let response = json!({
            "status": "success",
            "document_id": doc_id,
            "suggestions": suggestions.iter().map(|(suggestion, reasoning)| json!({
                "suggestion": suggestion,
                "reasoning": reasoning,
                "priority": "medium"
            })).collect::<Vec<_>>(),
            "model": ollama_model,
            "generated_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn call_ollama_mock(_ollama_endpoint: &str, _model: &str, prompt: &str) -> String {
        // Mock response - in production, this would call Ollama API
        format!("Response to prompt: '{}'. This is a mock response from Ollama. \
                 In production, this would call the Ollama API at the configured endpoint.", prompt)
    }

    fn get_expiry_time() -> String {
        let expiry = Utc::now() + chrono::Duration::hours(24);
        expiry.to_rfc3339()
    }

    fn read_body(request: &Request) -> Value {
        let mut body = Vec::new();
        let mut reader = request.as_reader();
        use std::io::Read;
        let _ = reader.read_to_end(&mut body);
        serde_json::from_slice(&body).unwrap_or_else(|_| json!({}))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_ai_server_creation() {
        let server = AiMcpServer::new(
            "http://127.0.0.1:8080",
            7005,
            "http://127.0.0.1:11434",
            "mistral"
        );
        assert_eq!(server.port, 7005);
        assert_eq!(server.ollama_model, "mistral");
    }

    #[test]
    fn test_cache_expiry() {
        let expiry = AiMcpServer::get_expiry_time();
        assert!(!expiry.is_empty(.to_string());
    }

    #[test]
    fn test_ollama_mock() {
        let response = AiMcpServer::call_ollama_mock(
            "http://127.0.0.1:11434",
            "mistral",
            "Test prompt"
        );
        assert!(response.contains("Test prompt".to_string());
    }
}

