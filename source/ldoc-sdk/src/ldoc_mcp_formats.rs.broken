use tiny_http::{Server, Response, Request, Method};
use serde_json::{json, Value};
use std::sync::{Arc, Mutex};
use std::collections::HashMap;
use uuid::Uuid;
use chrono::Utc;

/// LDOC Format Handler MCP Server
/// Handles document format conversion, import/export, 3D/media embedding
pub struct FormatsMcpServer {
    ldoc_api: String,
    port: u16,
    conversions: Arc<Mutex<HashMap<String, ConversionJob>>>,
}

#[derive(Clone)]
struct ConversionJob {
    id: String,
    from_format: String,
    to_format: String,
    status: String,
    created: String,
    completed: Option<String>,
    result_url: Option<String>,
}

impl FormatsMcpServer {
    pub fn new(ldoc_api: &str, port: u16) -> Self {
        Self {
            ldoc_api: ldoc_api.to_string(),
            port,
            conversions: Arc::new(Mutex::new(HashMap::new())),
        }
    }

    pub fn start(&self) {
        let server = Server::http(format!("127.0.0.1:{}", self.port))
            .expect("Failed to start Formats MCP server");

        println!("✓ Formats MCP Server listening on port {}", self.port);

        for request in server.incoming_requests() {
            let ldoc_api = self.ldoc_api.clone();
            let conversions = Arc::clone(&self.conversions);
            
            std::thread::spawn(move || {
                Self::handle_request(request, &ldoc_api, &conversions);
            });
        }
    }

    fn handle_request(request: Request, ldoc_api: &str, conversions: &Arc<Mutex<HashMap<String, ConversionJob>>>) {
        let method = request.method();
        let path = request.url();

        match (method, path.as_str()) {
            (Method::Get, "/health") => {
                let response = Response::from_string(json!({
                    "status": "healthy",
                    "service": "ldoc.formats",
                    "timestamp": Utc::now().to_rfc3339()
                }.to_string());
                let _ = request.respond(response);
            }
            (Method::Get, "/ldoc.formats.list") => {
                Self::list_formats(request);
            }
            (Method::Post, "/ldoc.formats.import") => {
                Self::import_file(request, ldoc_api);
            }
            (Method::Post, "/ldoc.formats.export") => {
                Self::export_document(request, ldoc_api);
            }
            (Method::Post, "/ldoc.formats.convert") => {
                Self::convert_format(request, ldoc_api, conversions);
            }
            (Method::Get, "/ldoc.formats.get_capabilities") => {
                Self::get_capabilities(request);
            }
            (Method::Post, "/ldoc.formats.embed_3d") => {
                Self::embed_3d_model(request, ldoc_api);
            }
            (Method::Post, "/ldoc.formats.embed_media") => {
                Self::embed_media(request, ldoc_api);
            }
            (Method::Post, "/ldoc.formats.validate_file") => {
                Self::validate_file(request);
            }
            _ => {
                let response = Response::from_string(json!({
                    "error": "Unknown tool",
                    "path": path,
                    "available_tools": [
                        "ldoc.formats.list",
                        "ldoc.formats.import",
                        "ldoc.formats.export",
                        "ldoc.formats.convert",
                        "ldoc.formats.get_capabilities",
                        "ldoc.formats.embed_3d",
                        "ldoc.formats.embed_media",
                        "ldoc.formats.validate_file"
                    ]
                })).with_status_code(404);
                let _ = request.respond(response);
            }
        }
    }

    fn list_formats(request: Request) {
        let formats = json!({
            "status": "success",
            "formats": {
                "3d_models": [
                    {"name": "glTF", "extensions": [".glb", ".gltf"], "capability": "real-time"},
                    {"name": "USD", "extensions": [".usd", ".usdz"], "capability": "production"},
                    {"name": "OBJ", "extensions": [".obj"], "capability": "static"},
                    {"name": "FBX", "extensions": [".fbx"], "capability": "rigged"},
                    {"name": "STL", "extensions": [".stl"], "capability": "3d-print"},
                    {"name": "STEP", "extensions": [".step", ".stp"], "capability": "cad"},
                    {"name": "IGES", "extensions": [".igs", ".iges"], "capability": "cad"},
                    {"name": "X3D", "extensions": [".x3d"], "capability": "interactive"},
                    {"name": "COLLADA", "extensions": [".dae"], "capability": "exchange"},
                    {"name": "PLY", "extensions": [".ply"], "capability": "pointcloud"}
                ],
                "documents": [
                    {"name": "PDF", "extensions": [".pdf"], "supports_3d": true},
                    {"name": "DOCX", "extensions": [".docx"], "supports_3d": true},
                    {"name": "PPTX", "extensions": [".pptx"], "supports_3d": true},
                    {"name": "ePub", "extensions": [".epub"], "supports_3d": false},
                    {"name": "HTML5", "extensions": [".html", ".htm"], "supports_3d": true},
                    {"name": "SVG", "extensions": [".svg"], "supports_3d": false}
                ]
            },
            "count": 16,
            "timestamp": Utc::now().to_rfc3339()
        });
        let _ = request.respond(Response::from_string(formats.to_string());
    }

    fn import_file(request: Request, ldoc_api: &str) {
        let body = Self::read_body(&request);
        
        let source_format = body.get("source_format")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let filename = body.get("filename")
            .and_then(|v| v.as_str())
            .unwrap_or("document");

        let doc_id = Uuid::new_v4().to_string();
        
        let response = json!({
            "status": "imported",
            "document_id": doc_id,
            "title": filename,
            "source_format": source_format,
            "url": format!("http://127.0.0.1:8080/?doc={}", doc_id),
            "pages": 1,
            "size_bytes": 1024000,
            "imported_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn export_document(request: Request, _ldoc_api: &str) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let target_format = body.get("target_format")
            .and_then(|v| v.as_str())
            .unwrap_or("pdf");

        let response = json!({
            "status": "exported",
            "document_id": doc_id,
            "target_format": target_format,
            "download_url": format!("http://127.0.0.1:8080/download/{}.{}", doc_id, target_format),
            "size_bytes": 2048000,
            "expires_in_hours": 24
        });
        
        let _ = request.respond(Response::from_string(response.to_string());
    }

    fn convert_format(request: Request, _ldoc_api: &str, conversions: &Arc<Mutex<HashMap<String, ConversionJob>>>) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let from_format = body.get("from_format")
            .and_then(|v| v.as_str())
            .unwrap_or("pdf");
        let to_format = body.get("to_format")
            .and_then(|v| v.as_str())
            .unwrap_or("docx");

        let conversion_id = Uuid::new_v4().to_string();
        let job = ConversionJob {
            id: conversion_id.clone(),
            from_format: from_format.to_string(),
            to_format: to_format.to_string(),
            status: "completed".to_string(),
            created: Utc::now().to_rfc3339(),
            completed: Some(Utc::now().to_rfc3339()),
            result_url: Some(format!("http://127.0.0.1:8080/download/{}_converted.{}", doc_id, to_format)),
        };
        
        conversions.lock().unwrap().insert(conversion_id.clone(), job);

        let response = json!({
            "status": "completed",
            "conversion_id": conversion_id,
            "document_id": doc_id,
            "from_format": from_format,
            "to_format": to_format,
            "result_url": format!("http://127.0.0.1:8080/download/{}_converted.{}", doc_id, to_format),
            "conversion_time_ms": 245
        });
        
        let _ = request.respond(Response::from_string(response.to_string());
    }

    fn get_capabilities(request: Request) {
        let capabilities = json!({
            "status": "success",
            "capabilities": {
                "3d_models": {
                    "viewing": true,
                    "editing": ["glb", "obj"],
                    "animation": ["fbx", "gltf"],
                    "real_time_rendering": ["glb", "gltf"]
                },
                "documents": {
                    "text_extraction": true,
                    "ocr": true,
                    "table_detection": true,
                    "form_recognition": true
                },
                "media": {
                    "image_formats": ["jpg", "png", "webp", "svg"],
                    "video_formats": ["mp4", "webm", "mov"],
                    "audio_formats": ["mp3", "wav", "ogg"]
                },
                "embedding": {
                    "3d_in_pdf": true,
                    "3d_in_docx": true,
                    "media_in_html": true,
                    "interactive_elements": true
                }
            }
        });
        
        let _ = request.respond(Response::from_string(capabilities.to_string());
    }

    fn embed_3d_model(request: Request, _ldoc_api: &str) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let model_format = body.get("model_format")
            .and_then(|v| v.as_str())
            .unwrap_or("glb");

        let response = json!({
            "status": "embedded",
            "document_id": doc_id,
            "model_format": model_format,
            "embedded_at": Utc::now().to_rfc3339(),
            "viewer_url": format!("http://127.0.0.1:8080/?doc={}&model=true", doc_id)
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn embed_media(request: Request, _ldoc_api: &str) {
        let body = Self::read_body(&request);
        
        let doc_id = body.get("document_id")
            .and_then(|v| v.as_str())
            .unwrap_or("unknown");
        let media_type = body.get("media_type")
            .and_then(|v| v.as_str())
            .unwrap_or("image");

        let response = json!({
            "status": "embedded",
            "document_id": doc_id,
            "media_type": media_type,
            "page": 1,
            "embedded_at": Utc::now().to_rfc3339()
        });
        
        let _ = request.respond(Response::from_string(response).with_status_code(201.to_string());
    }

    fn validate_file(request: Request) {
        let body = Self::read_body(&request);
        
        let filename = body.get("filename")
            .and_then(|v| v.as_str())
            .unwrap_or("file");
        
        let valid = !filename.is_empty();

        let response = json!({
            "valid": valid,
            "filename": filename,
            "errors": if valid { [] } else { ["Invalid filename".to_string()] },
            "warnings": [],
            "file_info": {
                "size_bytes": 1024,
                "format": "glb"
            }
        });
        
        let _ = request.respond(Response::from_string(response.to_string());
    }

    fn read_body(request: &Request) -> Value {
        let mut body = Vec::new();
        let mut reader = request.as_reader();
        use std::io::Read;
        let _ = reader.read_to_end(&mut body);
        serde_json::from_slice(&body).unwrap_or_else(|_| json!({}))
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_formats_server_creation() {
        let server = FormatsMcpServer::new("http://127.0.0.1:8080", 7002);
        assert_eq!(server.port, 7002);
    }

    #[test]
    fn test_conversion_job_tracking() {
        let conversions = Arc::new(Mutex::new(HashMap::new().to_string());
        let job = ConversionJob {
            id: "test-id".to_string(),
            from_format: "pdf".to_string(),
            to_format: "docx".to_string(),
            status: "completed".to_string(),
            created: Utc::now().to_rfc3339(),
            completed: Some(Utc::now().to_rfc3339()),
            result_url: Some("http://127.0.0.1:8080/download/test.docx".to_string()),
        };
        conversions.lock().unwrap().insert("test-id".to_string(), job.clone(.to_string());
        assert_eq!(conversions.lock().unwrap().len(), 1);
    }
}

