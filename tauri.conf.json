{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v1.5.0/tooling/cli/schema.json",
  "package": {
    "productName": "LDOC Studio",
    "version": "1.0.0"
  },
  "build": {
    "beforeBuildCommand": "cd source && cargo build --release -p ldoc-sdk --bin ldoc-launcher",
    "beforeDevCommand": "cd source && cargo build -p ldoc-sdk --bin ldoc-launcher",
    "devPath": "http://localhost:8080",
    "distDir": "../app/viewer",
    "withGlobalTauri": false
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": [
        "msi",
        "nsis"
      ],
      "identifier": "com.ldfx.ldocx",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "wix": {
          "language": "en-US"
        }
      }
    },
    "windows": [
      {
        "title": "LDOC Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https:; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline';"
    }
  }
}
