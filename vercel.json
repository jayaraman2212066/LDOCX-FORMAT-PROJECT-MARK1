{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/live-studio",
      "destination": "/live-studio.html"
    },
    {
      "source": "/live-studio/:match*",
      "destination": "/live-studio.html"
    },
    {
      "source": "/studio",
      "destination": "/live-studio.html"
    },
    {
      "source": "/studio/:match*",
      "destination": "/live-studio.html"
    },
    {
      "source": "/format",
      "destination": "/format.html"
    },
    {
      "source": "/features",
      "destination": "/features.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/changelog",
      "destination": "/changelog.html"
    },
    {
      "source": "/models",
      "destination": "/models.html"
    },
    {
      "source": "/templates",
      "destination": "/models.html"
    },
    {
      "source": "/creator",
      "destination": "/creator.html"
    },
    {
      "source": "/viewer",
      "destination": "/live-studio.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS, PUT, DELETE"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With, x-signature, stripe-signature"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:ldocx|3mf|stl|obj|glb))",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}