{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/creator",
      "destination": "/creator.html"
    },
    {
      "source": "/viewer",
      "destination": "/index.html"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/documents/build",
      "destination": "/api/build"
    },
    {
      "source": "/documents",
      "destination": "/api/documents"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth/register"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/me"
    },
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai/chat"
    },
    {
      "source": "/api/templates",
      "destination": "/api/templates"
    },
    {
      "source": "/api/optimize-model",
      "destination": "/api/optimize-model"
    },
    {
      "source": "/api/checkout/create-session",
      "destination": "/api/checkout/create-session"
    },
    {
      "source": "/api/checkout/webhook",
      "destination": "/api/checkout/webhook"
    },
    {
      "source": "/api/leads/capture",
      "destination": "/api/leads/capture"
    },
    {
      "source": "/api/export/pdf",
      "destination": "/api/export/pdf"
    },
    {
      "source": "/api/validate",
      "destination": "/api/validate"
    },
    {
      "source": "/api/convert",
      "destination": "/api/convert"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS, PUT, DELETE"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:ldocx|3mf|stl|obj|glb))",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "outputDirectory": "public"
}