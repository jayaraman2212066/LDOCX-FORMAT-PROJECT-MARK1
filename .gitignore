# Rust compilation target directories
/source/target/
target/
**/target/

# Windows symbols and temp files
*.pdb
*.obj
*.lib
*.exp
*.ilk

# Visual Studio / IDE
.vs/
.vscode/
.idea/

# Large installers / redistributables
redist/
output/
*.log

# Environment secrets and API keys
.env
.env.*
!*.example
*.env
backend/.env
!backend/.env.example

# OS files
.DS_Store
Thumbs.db

# Backups
_backups/

# Node modules
node_modules/
**/node_modules/

# Scratch and temp build files
scratch/
**/scratch/

# Desktop distributions
# (downloads/ hosted statically in repo/site)
packages/ldoc-studio/*.zip
packages/ldoc-studio/electron/
**/electron/

# Large VIP release archives (>100MB GitHub push limit, served locally/statically)
downloads/LDOC-Studio-*-VIP.*
public/downloads/LDOC-Studio-*-VIP.*
app/viewer/downloads/LDOC-Studio-*-VIP.*

